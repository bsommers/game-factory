{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "locomotion3d.schema.json",
  "title": "locomotion3d config",
  "description": "All sections and keys optional; missing keys take defaults. Cross-field rules (walk<=run<=sprint, iframeStart<=iframeEnd<=duration, wadeDepth<swimDepth, ...) are checked by locomotion3d.validate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5,
          "default": 0.4
        },
        "height": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 10,
          "default": 1.8
        },
        "stepHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.35
        },
        "slopeLimitDeg": {
          "type": "number",
          "minimum": 5,
          "maximum": 85,
          "default": 50
        }
      }
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "walkSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "default": 2.2
        },
        "runSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 40,
          "default": 5.2
        },
        "sprintSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60,
          "default": 8
        },
        "runThreshold": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.6
        },
        "accel": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 500,
          "default": 40
        },
        "decel": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 500,
          "default": 50
        },
        "turnRateDeg": {
          "type": "number",
          "minimum": 10,
          "maximum": 5000,
          "default": 720
        }
      }
    },
    "air": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accel": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "default": 14
        },
        "decel": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "default": 3
        },
        "turnRateDeg": {
          "type": "number",
          "minimum": 10,
          "maximum": 5000,
          "default": 360
        },
        "gravity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200,
          "default": 28
        },
        "fallGravityMul": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1.25
        },
        "maxFallSpeed": {
          "type": "number",
          "minimum": 1,
          "maximum": 200,
          "default": 40
        }
      }
    },
    "jump": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "default": 9
        },
        "coyoteTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "bufferTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.12
        },
        "cutMultiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.45
        },
        "airJumps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "airJumpSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "default": 8
        },
        "inheritPlatform": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "land": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 3
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.08
        },
        "hardSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "default": 14
        },
        "hardTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "default": 0.45
        },
        "hardMoveMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2
        }
      }
    },
    "dodge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30,
          "default": 4
        },
        "duration": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3,
          "default": 0.5
        },
        "iframeStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "default": 0.05
        },
        "iframeEnd": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "default": 0.3
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 0.25
        },
        "exitSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "default": 2
        },
        "airDodges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "curve": {
          "type": "string",
          "enum": [
            "constant",
            "easeOut"
          ],
          "default": "easeOut"
        },
        "turnToDir": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "swim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wadeDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0.25
        },
        "swimDepth": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1.2
        },
        "wadeSpeedMul": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.7
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20,
          "default": 3
        },
        "accel": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200,
          "default": 10
        },
        "floatOffset": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 1.4
        },
        "buoyancy": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 50,
          "default": 4
        },
        "maxVerticalSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30,
          "default": 3
        },
        "verticalDamp": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "default": 8
        },
        "exitJumpMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.8
        },
        "exitJumpWindow": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "default": 0.4
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAngleDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 89,
          "default": 38
        },
        "accel": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "default": 18
        },
        "maxSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60,
          "default": 12
        },
        "control": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        }
      }
    },
    "knockback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groundDecel": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 500,
          "default": 14
        },
        "airDecel": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "default": 1.5
        },
        "stunDefault": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0.35
        }
      }
    }
  }
}
