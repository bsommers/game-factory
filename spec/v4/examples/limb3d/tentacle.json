{
  "$schema": "../../schemas/limb3d.schema.json",
  "id": "tentacle",
  "description": "Twelve-segment tapered tentacle: supple, wide sweep and a lunge, quick regrow.",
  "segments": 12,
  "segmentLengths": [1, 1, 1, 0.95, 0.9, 0.85, 0.8, 0.75, 0.7, 0.65, 0.6, 0.55],
  "radius": { "base": 0.45, "tip": 0.08 },
  "root": { "pos": [6, 0, 0], "dir": [0, 1, 0] },
  "solver": "fabrik",
  "iterations": 10,
  "maxBend": 28,
  "maxBase": 70,
  "restFrac": 0.8,
  "seek": { "range": 20, "speed": 5 },
  "sway": { "amp": 0.07, "freq": 0.4 },
  "sever": { "minKeep": 2 },
  "regrow": { "delay": 4, "interval": 0.6 },
  "motions": {
    "sweep": { "kind": "sweep", "windup": 0.7, "strike": 0.9, "recover": 0.6, "curves": { "windup": "easeOut", "strike": "linear", "recover": "easeInOut" }, "damage": 12, "hitSegments": 5, "arc": [-70, 70], "radius": 7, "height": 0.6, "warning": { "vfx": "ground-line" } },
    "lunge": { "kind": "strike", "windup": 0.6, "strike": 0.15, "recover": 0.6, "damage": 14, "hitSegments": 3, "retract": 0.4, "lift": 2 }
  }
}
