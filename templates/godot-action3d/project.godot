; Engine configuration file. Template: godot-action3d (third-person action skeleton).
config_version=5

[application]

config/name="__NAME__"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"keycode":0,"unicode":0,"pressed":false,"echo":false)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"keycode":0,"unicode":0,"pressed":false,"echo":false)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"keycode":0,"unicode":0,"pressed":false,"echo":false)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"keycode":0,"unicode":0,"pressed":false,"echo":false)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"keycode":0,"unicode":0,"pressed":false,"echo":false)]
}

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
