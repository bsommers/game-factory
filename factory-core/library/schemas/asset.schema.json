{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-factory/schemas/asset.schema.json",
  "title": "Asset descriptor (assets/<id>/asset.json)",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "license",
    "author",
    "tags",
    "files",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "type": {
      "enum": [
        "sprite",
        "character",
        "tileset",
        "sfx",
        "song",
        "fx",
        "font",
        "level",
        "doc",
        "code-kit",
        "model",
        "animation",
        "texture",
        "material",
        "hdri",
        "music"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._-]{0,63}$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 300
        },
        "generator": {
          "type": "string",
          "maxLength": 200
        },
        "game": {
          "type": "string",
          "maxLength": 120
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "tool": {
          "type": "string",
          "maxLength": 120
        },
        "jobId": {
          "type": "string",
          "maxLength": 200
        },
        "plan": {
          "enum": [
            "free",
            "pro",
            "studio",
            "enterprise",
            "unknown"
          ]
        },
        "visibility": {
          "enum": [
            "private",
            "community"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 4000
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 500
        },
        "derivedFrom": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "format": {
      "type": "string",
      "maxLength": 40
    },
    "palette": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "size": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "maximum": 36000
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "library": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "preview": {
      "type": "string",
      "maxLength": 240
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "licenseInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "enum": [
            "verified",
            "self-owned",
            "needs-review",
            "unknown",
            "blocked"
          ]
        },
        "redistribute": {
          "type": "boolean"
        },
        "commercialUse": {
          "type": "boolean"
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "maxLength": 500
            },
            "url": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "licenseFile": {
          "type": "string",
          "maxLength": 240
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "verifiedBy": {
          "type": "string",
          "maxLength": 120
        },
        "verifiedAt": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "ipReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "clear",
            "flagged",
            "unchecked"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 120
        },
        "reviewedAt": {
          "type": "string",
          "maxLength": 40
        },
        "hits": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "maxLength": 40
        },
        "tris": {
          "type": "integer",
          "minimum": 0
        },
        "verts": {
          "type": "integer",
          "minimum": 0
        },
        "materials": {
          "type": "integer",
          "minimum": 0
        },
        "textures": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object"
          }
        },
        "bounds": {
          "type": "object"
        },
        "unitScale": {
          "type": "number"
        },
        "upAxis": {
          "enum": [
            "Y",
            "Z"
          ]
        },
        "rig": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "humanoid",
                "quadruped",
                "custom"
              ]
            },
            "bones": {
              "type": "integer",
              "minimum": 0
            },
            "skinned": {
              "type": "boolean"
            },
            "skeletonHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "clips": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "loop": {
                "type": "boolean"
              },
              "fps": {
                "type": "number",
                "minimum": 0
              },
              "file": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "compression": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "extensionsRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "animation": {
      "type": "object",
      "properties": {
        "targetRig": {
          "type": "string",
          "maxLength": 80
        },
        "skeletonHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clips": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "loop": {
                "type": "boolean"
              },
              "fps": {
                "type": "number",
                "minimum": 0
              },
              "file": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "maxLength": 20
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "loopable": {
          "type": "boolean"
        },
        "bpm": {
          "type": "number",
          "minimum": 0
        },
        "loudnessLufs": {
          "type": "number"
        }
      }
    },
    "thumbnail": {
      "type": "string",
      "maxLength": 240
    },
    "contentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "active",
        "withdrawn"
      ]
    }
  }
}
