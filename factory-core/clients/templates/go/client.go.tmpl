// Package factoryclient is a typed thin client for the game-factory HTTP API (bin/factory serve).
// Standard library only. Generated by `factory clients generate`; edit the templates, not this file.
package factoryclient

import (
	"bufio"
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"strings"
	"time"
)

// DefaultBaseURL is where `factory serve` listens by default (loopback only).
const DefaultBaseURL = "http://127.0.0.1:4790"

// DefaultTimeout bounds every request except the SSE stream (that one is bounded by its context).
const DefaultTimeout = 30 * time.Second

// Stable error.code values. TRANSPORT and BAD_RESPONSE are produced by this client, never by the server.
const (
@@ERROR_CODES@@
)

// APIVersion is the OpenAPI document version this client was generated from.
const APIVersion = "@@VERSION@@"

// ErrorInfo is the envelope's error member.
type ErrorInfo struct {
	Code    string          `json:"code"`
	Message string          `json:"message"`
	Details json.RawMessage `json:"details,omitempty"`
}

// Envelope is the {ok,data,error,next} result every capability returns.
type Envelope struct {
	OK    bool            `json:"ok"`
	Data  json.RawMessage `json:"data"`
	Error *ErrorInfo      `json:"error"`
	Next  []string        `json:"next"`
}

// Decode unmarshals Data into v.
func (e *Envelope) Decode(v any) error { return json.Unmarshal(e.Data, v) }

// Error is returned when the factory reports ok=false or the call could not be completed.
// Match with errors.As and compare Code to the Err* constants.
type Error struct {
	Code    string
	Message string
	Status  int // HTTP status, 0 for transport errors
	Details json.RawMessage
	Next    []string
}

func (e *Error) Error() string { return fmt.Sprintf("factory: %s: %s", e.Code, e.Message) }

// Client talks to one factory server. The zero value is not usable; use New.
type Client struct {
	BaseURL string
	HTTP    *http.Client // request timeout is DefaultTimeout
}

// New returns a client for baseURL (empty means DefaultBaseURL).
func New(baseURL string) *Client {
	if baseURL == "" {
		baseURL = DefaultBaseURL
	}
	return &Client{BaseURL: strings.TrimRight(baseURL, "/"), HTTP: &http.Client{Timeout: DefaultTimeout}}
}

func (c *Client) do(ctx context.Context, method, path string, body any) (int, []byte, error) {
	var rd io.Reader
	if body != nil {
		b, err := json.Marshal(body)
		if err != nil {
			return 0, nil, &Error{Code: ErrBadInput, Message: err.Error()}
		}
		rd = bytes.NewReader(b)
	}
	req, err := http.NewRequestWithContext(ctx, method, c.BaseURL+path, rd)
	if err != nil {
		return 0, nil, &Error{Code: ErrTransport, Message: err.Error()}
	}
	if body != nil {
		req.Header.Set("Content-Type", "application/json")
	}
	req.Header.Set("Accept", "application/json")
	resp, err := c.HTTP.Do(req)
	if err != nil {
		return 0, nil, &Error{Code: ErrTransport, Message: err.Error()}
	}
	defer resp.Body.Close()
	b, err := io.ReadAll(io.LimitReader(resp.Body, 64<<20))
	if err != nil {
		return resp.StatusCode, nil, &Error{Code: ErrTransport, Message: err.Error(), Status: resp.StatusCode}
	}
	return resp.StatusCode, b, nil
}

func parseEnvelope(status int, b []byte) (*Envelope, error) {
	var env Envelope
	if err := json.Unmarshal(b, &env); err != nil {
		return nil, &Error{Code: ErrBadResponse, Message: fmt.Sprintf("HTTP %d: not an envelope: %v", status, err), Status: status}
	}
	if !env.OK {
		e := &Error{Code: ErrFailed, Status: status, Next: env.Next}
		if env.Error != nil {
			e.Code, e.Message, e.Details = env.Error.Code, env.Error.Message, env.Error.Details
		}
		return &env, e
	}
	return &env, nil
}

// Call invokes any capability by name: POST /api/<name>. in may be nil, a struct, or a map.
// When the factory answers ok=false the envelope is returned together with a *Error.
func (c *Client) Call(ctx context.Context, name string, in any) (*Envelope, error) {
	if in == nil {
		in = map[string]any{}
	}
	status, b, err := c.do(ctx, http.MethodPost, "/api/"+name, in)
	if err != nil {
		return nil, err
	}
	return parseEnvelope(status, b)
}

// Capabilities fetches GET /capabilities (names, summaries and schemas).
func (c *Client) Capabilities(ctx context.Context) (*Envelope, error) {
	status, b, err := c.do(ctx, http.MethodGet, "/capabilities", nil)
	if err != nil {
		return nil, err
	}
	return parseEnvelope(status, b)
}

// OpenAPI returns the raw GET /openapi.json document.
func (c *Client) OpenAPI(ctx context.Context) ([]byte, error) {
	_, b, err := c.do(ctx, http.MethodGet, "/openapi.json", nil)
	return b, err
}

// Event is one server-sent event; Data is the JSON payload of a "progress" event.
type Event struct {
	Name string
	Data json.RawMessage
}

// Events streams GET /events?project=<dir>[&since=ISO]. Both channels are closed when the stream ends;
// at most one error is sent. Cancel ctx to stop. Comment pings are skipped.
func (c *Client) Events(ctx context.Context, project, since string) (<-chan Event, <-chan error) {
	evs, errs := make(chan Event), make(chan error, 1)
	go func() {
		defer close(evs)
		defer close(errs)
		q := url.Values{"project": {project}}
		if since != "" {
			q.Set("since", since)
		}
		req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.BaseURL+"/events?"+q.Encode(), nil)
		if err != nil {
			errs <- &Error{Code: ErrTransport, Message: err.Error()}
			return
		}
		req.Header.Set("Accept", "text/event-stream")
		resp, err := (&http.Client{}).Do(req) // no overall timeout: the stream is long-lived
		if err != nil {
			errs <- &Error{Code: ErrTransport, Message: err.Error()}
			return
		}
		defer resp.Body.Close()
		if resp.StatusCode != http.StatusOK {
			errs <- &Error{Code: ErrTransport, Message: fmt.Sprintf("events: HTTP %d", resp.StatusCode), Status: resp.StatusCode}
			return
		}
		sc := bufio.NewScanner(resp.Body)
		sc.Buffer(make([]byte, 64<<10), 4<<20)
		name, data := "", ""
		for sc.Scan() {
			line := sc.Text()
			switch {
			case line == "":
				if data != "" {
					select {
					case evs <- Event{Name: name, Data: json.RawMessage(data)}:
					case <-ctx.Done():
						return
					}
				}
				name, data = "", ""
			case strings.HasPrefix(line, ":"):
			case strings.HasPrefix(line, "event:"):
				name = strings.TrimSpace(line[6:])
			case strings.HasPrefix(line, "data:"):
				if data != "" {
					data += "\n"
				}
				data += strings.TrimPrefix(line[5:], " ")
			}
		}
		if err := sc.Err(); err != nil && ctx.Err() == nil {
			errs <- &Error{Code: ErrTransport, Message: err.Error()}
		}
	}()
	return evs, errs
}
