{
  "id": "retro-16bit",
  "name": "Retro 16-bit",
  "description": "SNES/Genesis-era 2D: larger native canvas, per-sprite ramps, dithering, parallax layers, FM or sample-flavoured audio.",
  "genre": [
    "platformer",
    "action",
    "rpg-lite"
  ],
  "camera": "side-scroller",
  "render": {
    "tech": "canvas2d-pixel",
    "dimension": "2d",
    "resolution": {
      "width": 384,
      "height": 216,
      "scaling": "integer-nearest",
      "integerOnly": true
    },
    "notes": "Two or three parallax layers drawn from pre-baked canvases; sprites up to 32x48."
  },
  "palette": {
    "policy": "ramps",
    "maxColors": 256,
    "rampSize": 6,
    "notes": "Per-object 6-step ramps (hue-shifted shadows); 16 colours per sprite, 256 overall."
  },
  "art": {
    "kit": "art-kit",
    "tileSize": 16,
    "spriteSize": [
      32,
      48
    ],
    "outline": "selective",
    "settings": {
      "dither": "bayer2"
    }
  },
  "character": {
    "kit": "character-kit",
    "rig": "param-rig",
    "animFps": 14
  },
  "audio": {
    "engine": "fm",
    "channels": 8,
    "bitDepth": 12,
    "sampleRate": 32000,
    "mood": "lush, melodic",
    "settings": {
      "operators": 4,
      "reverb": "cheap-comb"
    }
  },
  "fx": [
    {
      "id": "dither",
      "default": true,
      "strength": 0.5
    },
    {
      "id": "bloom",
      "default": false,
      "strength": 0.2
    },
    {
      "id": "screen-shake",
      "default": true
    },
    {
      "id": "particles",
      "default": true
    },
    {
      "id": "palette-cycle",
      "default": true,
      "strength": 0.5,
      "note": "water and lava shimmer"
    }
  ],
  "physics": {
    "model": "tile kinematics with slopes and one-way platforms",
    "fixedStep": 0.016666666666666666
  },
  "worldgen": {
    "method": "hand-authored rooms plus seeded fill",
    "seeded": true
  },
  "input": {
    "scheme": "dpad + 2-3 buttons (jump, attack, special)",
    "devices": [
      "keyboard",
      "gamepad"
    ]
  },
  "performance": {
    "targetFps": 60,
    "frameBudgetMs": 10,
    "minDevice": "low",
    "drawCalls": 800,
    "memoryMB": 128
  },
  "swarm": {
    "shape": "contract-first fan-out; art split by biome",
    "agentCount": [
      10,
      18
    ],
    "roles": [
      {
        "role": "architect (ARCHITECTURE.md contract)",
        "model": "opus"
      },
      {
        "role": "art agents (sprites, tiles, scenery)",
        "model": "sonnet"
      },
      {
        "role": "sim/gameplay agents",
        "model": "sonnet"
      },
      {
        "role": "audio agents",
        "model": "sonnet"
      },
      {
        "role": "render/UI shell",
        "model": "sonnet"
      },
      {
        "role": "QA bot + verification",
        "model": "sonnet"
      },
      {
        "role": "boilerplate, lint, docs",
        "model": "haiku"
      }
    ]
  },
  "verification": [
    "node --test passes",
    "every sprite uses at most 16 colours from its ramp",
    "parallax layers scroll at distinct rates without seams",
    "screenshots per biome are legible",
    "FPS >= 55 on low tier",
    "audio renders offline to a non-silent WAV"
  ],
  "pitfalls": [
    "256 colours tempts ramp sprawl: enforce per-sprite limit",
    "parallax seams at wrap points",
    "FM patches that clip: normalise offline",
    "larger sprites multiply art cost"
  ],
  "examples": [
    {
      "game": "KÄSEKRIEG",
      "role": "fits"
    },
    {
      "game": "PawFall",
      "role": "aspirational",
      "note": "a 16-bit remake"
    }
  ],
  "tags": [
    "retro",
    "16bit",
    "pixel",
    "platformer",
    "2d",
    "parallax"
  ],
  "requires": {
    "kits": [
      "art-kit",
      "character-kit",
      "audio-kit",
      "fx-kit"
    ],
    "libs": [
      "platformer-physics",
      "world-gen"
    ],
    "skills": []
  },
  "tech": {
    "dependencies": "none",
    "choices": [
      "Canvas2D",
      "WebAudio FM voices",
      "pre-baked layer canvases"
    ],
    "limits": [
      "no real hardware mode-7",
      "sprite budget about 200 on screen"
    ]
  },
  "recommend": {
    "keywords": {
      "16-bit": 8,
      "16bit": 8,
      "snes": 7,
      "genesis": 6,
      "megadrive": 6,
      "metroidvania": 5,
      "action platformer": 5,
      "lush": 2,
      "parallax": 3,
      "retro": 2,
      "pixel art": 3,
      "rpg": 1
    },
    "anti": {
      "3d": 6,
      "ascii": 6,
      "fps": 5
    },
    "cost": 3,
    "platforms": [
      "web",
      "desktop"
    ],
    "pros": [
      "richer visuals than 8-bit",
      "still cheap to render"
    ],
    "cons": [
      "more art per sprite",
      "more QA on layers"
    ]
  },
  "themingGuide": "THEMING.md",
  "version": "1.0.0"
}
