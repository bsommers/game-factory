+      const cases = allMods.map((m) => { let rel = relative(join(tmp, 'src', dir === '.' ? '' : dir), join(tmp, 'src', m)).split('\\').join('/'); if (!rel.startsWith('.')) rel = './' + rel; return `case ${JSON.stringify(m)}: return import(${JSON.stringify(rel)});`; }).join(' ');
