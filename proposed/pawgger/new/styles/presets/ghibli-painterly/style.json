{
  "id": "ghibli-painterly",
  "name": "Ghibli Painterly",
  "description": "Soft hand-painted vector look on Canvas2D: gradient-shaded organic shapes, watercolour edges, paper grain, fluffy clouds, gentle motion and gentle music. Original look, no copied film assets.",
  "genre": [
    "casual",
    "arcade",
    "adventure",
    "family"
  ],
  "camera": "top-down",
  "render": {
    "tech": "canvas2d-vector",
    "dimension": "2d",
    "resolution": {
      "width": 896,
      "height": 1024,
      "scaling": "fit-letterbox",
      "integerOnly": false
    },
    "notes": "Sprites drawn at 4x logical size with smoothing on; CSS image-rendering: auto; cache every static sprite to an offscreen surface."
  },
  "palette": {
    "policy": "free",
    "maxColors": 4096,
    "notes": "Warm soft palette with plum ink (#3b2f3a) at low alpha instead of black; derive shade/light by mixing toward plum and cream."
  },
  "art": {
    "kit": "painter-kit",
    "outline": "vector-stroke",
    "settings": {
      "strokeAlpha": 0.3,
      "grain": "paperGrain",
      "fill": "washFill"
    }
  },
  "character": {
    "kit": "painter-kit",
    "rig": "param-rig",
    "animFps": 30
  },
  "audio": {
    "engine": "procedural-webaudio",
    "channels": 8,
    "bitDepth": 16,
    "sampleRate": 44100,
    "mood": "gentle: sine/triangle piano, strings, flute lead, waltz or 6/8, 84-110 bpm"
  },
  "fx": [
    {
      "id": "particles",
      "default": true,
      "note": "soft particles: petals, fireflies, bubbles"
    },
    {
      "id": "vignette",
      "default": true,
      "strength": 0.25
    },
    {
      "id": "bloom",
      "default": false,
      "strength": 0.15
    },
    {
      "id": "outlines",
      "default": false
    },
    {
      "id": "crt",
      "default": false,
      "note": "no CRT"
    },
    {
      "id": "screen-shake",
      "default": true,
      "strength": 0.15
    }
  ],
  "physics": {
    "model": "simple rigid bodies or arcade kinematics; springs for squash/stretch",
    "fixedStep": 0.016666666666666666
  },
  "worldgen": {
    "method": "hand-authored levels with seeded decoration",
    "seeded": true
  },
  "input": {
    "scheme": "keyboard or pointer; touch friendly",
    "devices": [
      "keyboard",
      "mouse",
      "touch",
      "gamepad"
    ]
  },
  "performance": {
    "targetFps": 60,
    "frameBudgetMs": 12,
    "minDevice": "mid",
    "drawCalls": 1500,
    "memoryMB": 256
  },
  "swarm": {
    "shape": "contract-first; art agents work on shared rig and path helpers",
    "agentCount": [
      8,
      14
    ],
    "roles": [
      {
        "role": "architect (ARCHITECTURE.md contract)",
        "model": "opus"
      },
      {
        "role": "art agents (sprites, tiles, scenery)",
        "model": "sonnet"
      },
      {
        "role": "sim/gameplay agents",
        "model": "sonnet"
      },
      {
        "role": "audio agents",
        "model": "sonnet"
      },
      {
        "role": "render/UI shell",
        "model": "sonnet"
      },
      {
        "role": "QA bot + verification",
        "model": "sonnet"
      },
      {
        "role": "boilerplate, lint, docs",
        "model": "haiku"
      }
    ]
  },
  "verification": [
    "node --test passes (recording ctx shim)",
    "headless screenshot of the sample sprite sheet looks painterly",
    "FPS >= 55 with cached sprites",
    "text contrast >= 4.5",
    "no console errors"
  ],
  "pitfalls": [
    "running paperGrain every frame: bake it into cached surfaces",
    "pixelated CSS scaling: use image-rendering: auto",
    "pure black outlines: use plum ink at low alpha",
    "Math.random in art: use seeded rng so screenshots are deterministic"
  ],
  "examples": [
    {
      "game": "Pawgger",
      "role": "fits"
    }
  ],
  "tags": [
    "painterly",
    "watercolour",
    "ghibli-inspired",
    "smooth",
    "cozy",
    "2d",
    "vector"
  ],
  "requires": {
    "kits": [
      "painter-kit",
      "fx-kit",
      "audio-kit"
    ],
    "libs": [],
    "skills": []
  },
  "tech": {
    "dependencies": "none",
    "choices": [
      "Canvas2D paths and gradients",
      "offscreen surface caching",
      "seeded grain",
      "smooth scaling (imageSmoothingEnabled)"
    ],
    "limits": [
      "cache static sprites; paperGrain only on baked layers",
      "no GPU shaders"
    ]
  },
  "recommend": {
    "keywords": {
      "painterly": 9,
      "ghibli": 8,
      "watercolour": 8,
      "watercolor": 8,
      "cozy": 6,
      "cute": 4,
      "hand-painted": 7,
      "gentle": 4,
      "anime": 3
    },
    "anti": {
      "8-bit": 6,
      "ascii": 6,
      "crt": 5,
      "fps": 4
    },
    "cost": 3,
    "platforms": [
      "web",
      "desktop"
    ],
    "pros": [
      "warm charming look",
      "resolution independent",
      "deterministic with seeds"
    ],
    "cons": [
      "needs sprite caching for perf",
      "more art code than pixel art"
    ]
  },
  "themingGuide": "THEMING.md",
  "version": "1.0.0"
}