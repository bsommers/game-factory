{
  "applicationId": "dev.catxzzon.game",
  "version": "__VERSION__",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": ["app.exit", "window.setFullScreen", "window.exitFullScreen", "window.isFullScreen", "events.on", "events.off"],
  "modes": {
    "window": {
      "title": "CATXZZON",
      "width": 960,
      "height": 540,
      "minWidth": 480,
      "minHeight": 270,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    },
    "browser": { "globalVariables": {}, "nativeBlockList": ["filesystem.*", "os.*", "computer.*", "updater.*"] }
  },
  "cli": { "binaryName": "catxzzon", "resourcesPath": "/resources/", "clientLibrary": "/resources/js/neutralino.js", "binaryVersion": "__NL__", "clientVersion": "6.7.0" }
}
